<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NAVJ AI Sécurité</title>
<style>
:root{--bg:#07120d;--or:#F77F00;--vt:#009E60;--tx:#f4f1e8;--mu:#9db3a6}
*{box-sizing:border-box}
body{margin:auto;max-width:520px;font-family:system-ui,sans-serif;background:var(--bg);color:var(--tx);padding:10px 10px 84px;background-image:radial-gradient(circle at 80% 0,#F77F0026,transparent 45%),radial-gradient(circle at 0 30%,#009E6030,transparent 50%);background-attachment:fixed}
.c{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:14px;margin-top:12px}
h1{font-size:19px;margin:0;line-height:1.2}
h2{font-size:16px;margin:0 0 8px;border-left:4px solid var(--or);padding-left:8px}
.mu{color:var(--mu);font-size:13px}
input,select,textarea{width:100%;padding:12px;margin-top:8px;border-radius:10px;border:1px solid #2b4538;background:#0d1f17;color:#fff;font-size:15px}
button{width:100%;margin-top:8px;padding:13px;border:0;border-radius:12px;font:inherit;font-weight:800;cursor:pointer}
button:active{transform:scale(.98)}
.or{background:linear-gradient(90deg,#F77F00,#ffb347);color:#1a0d00}.vt{background:var(--vt);color:#fff}.gr{background:#1c3329;color:#fff}.rg{background:#d93a1f;color:#fff}
.l{display:flex;gap:8px}.l>*{flex:1}
.top{display:flex;align-items:center;gap:8px;text-align:center}
.top>div{flex:1}.top svg{width:78px;height:78px;flex:none}
.badge{background:#000;color:#ffcc00;border-radius:20px;padding:3px 10px;font-size:12px;font-weight:800}
.vocal{border:2px dashed var(--vt);border-radius:12px;padding:12px;margin-top:10px}
#rapport{background:#fff;color:#111;padding:14px;border-radius:10px;white-space:pre-wrap;min-height:70px;margin-top:8px;font-size:14px}
.h{border-top:1px solid rgba(255,255,255,.1);padding:8px 0;font-size:13px;display:flex;justify-content:space-between;gap:8px;align-items:center}
.h button{width:auto;margin:0;padding:6px 10px;font-size:12px}
nav{position:fixed;left:0;right:0;bottom:0;display:flex;background:#050c09;border-top:2px solid var(--or);max-width:520px;margin:auto}
nav button{margin:0;border-radius:0;background:none;color:var(--mu);font-size:11px;padding:10px 2px}
nav button.on{color:var(--or);background:#0d1f17}
.sec{display:none}.sec.on{display:block}
.cl{display:flex;justify-content:space-between;padding:8px 0;border-top:1px solid rgba(255,255,255,.08)}
.big{font-size:38px;font-weight:800;text-align:center;font-variant-numeric:tabular-nums;color:var(--or)}
.log{height:230px;overflow:auto;background:#0a1711;border-radius:10px;padding:8px;margin-top:8px}
.m{max-width:88%;padding:8px 11px;border-radius:12px;margin:6px 0;font-size:14px;white-space:pre-wrap}
.m.ia{background:#1c3329}.m.mo{background:var(--vt);margin-left:auto}
.ch{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.ch button{width:auto;margin:0;padding:6px 10px;font-size:12px;background:#143024;color:#cfe9db;border-radius:20px}
#toast{position:fixed;left:50%;bottom:76px;transform:translateX(-50%);background:#000;color:#fff;padding:10px 16px;border-radius:20px;font-size:14px;opacity:0;transition:opacity .25s;pointer-events:none;border:1px solid var(--or);text-align:center;max-width:90%}
#toast.on{opacity:1}
.terre{animation:tourne 16s linear infinite}
@keyframes tourne{to{transform:translateX(-200px)}}
@media(prefers-reduced-motion:reduce){.terre{animation:none}}
</style>
</head>
<body>

<header class="c" style="border-color:var(--or)">
  <div class="top">
    <svg viewBox="0 0 190 200" aria-label="Carte de la Côte d'Ivoire">
      <defs><clipPath id="ci"><polygon points="3,12 24,19 51,21 81,12 99,2 120,30 165,27 180,39 183,84 186,135 174,171 141,168 111,170 81,183 36,192 33,159 9,129 6,96 15,69 24,54 12,36"/></clipPath></defs>
      <g clip-path="url(#ci)"><rect width="64" height="200" fill="#F77F00"/><rect x="64" width="63" height="200" fill="#fff"/><rect x="127" width="63" height="200" fill="#009E60"/></g>
      <polygon points="3,12 24,19 51,21 81,12 99,2 120,30 165,27 180,39 183,84 186,135 174,171 141,168 111,170 81,183 36,192 33,159 9,129 6,96 15,69 24,54 12,36" fill="none" stroke="#fff" stroke-width="3"/>
      <circle cx="141" cy="164" r="7" fill="#d93a1f" stroke="#fff" stroke-width="2"/>
    </svg>
    <div>
      <h1>NAVJ AI<br>SÉCURITÉ</h1>
      <div class="mu">Côte d'Ivoire · Abidjan</div>
      <div style="margin-top:6px">Mode : <b id="mode">Gratuit</b> <span id="badge" class="badge" hidden>Premium</span></div>
      <div class="mu" id="quota"></div>
    </div>
    <svg viewBox="0 0 200 200" aria-label="Globe terrestre">
      <defs>
        <clipPath id="gl"><circle cx="100" cy="100" r="96"/></clipPath>
        <radialGradient id="mer" cx=".35" cy=".3"><stop offset="0" stop-color="#3aa0e8"/><stop offset="1" stop-color="#0b3d6b"/></radialGradient>
        <radialGradient id="om" cx=".4" cy=".35" r=".7"><stop offset=".55" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".6"/></radialGradient>
        <g id="co" fill="#3fbf7a"><path d="M20 30 50 25 60 50 45 80 55 110 45 150 35 130 30 90Z"/><path d="M95 40 125 35 135 70 125 110 110 140 100 110 90 70Z"/><path d="M140 35 185 30 195 65 170 85 150 70Z"/><path d="M165 125 190 122 192 142 170 145Z"/></g>
      </defs>
      <circle cx="100" cy="100" r="96" fill="url(#mer)"/>
      <g clip-path="url(#gl)"><g class="terre"><use href="#co"/><use href="#co" x="200"/><use href="#co" x="400"/></g>
        <g fill="none" stroke="#fff" stroke-opacity=".25"><ellipse cx="100" cy="100" rx="96" ry="30"/><ellipse cx="100" cy="100" rx="96" ry="64"/><line x1="4" y1="100" x2="196" y2="100"/></g></g>
      <circle cx="100" cy="100" r="96" fill="url(#om)"/>
      <circle cx="100" cy="100" r="96" fill="none" stroke="#fff" stroke-opacity=".4" stroke-width="2"/>
    </svg>
  </div>
  <div id="plateau" style="margin-top:8px">
    <svg viewBox="0 0 400 80" style="width:100%;display:block" aria-label="Le Plateau, Abidjan">
      <circle cx="320" cy="30" r="22" fill="#F77F00" opacity=".85"/>
      <g fill="#04100a">
        <rect x="0" y="70" width="400" height="10"/>
        <rect x="14" y="40" width="22" height="31"/><rect x="40" y="26" width="18" height="45"/>
        <polygon points="68,71 100,22 132,71"/><polygon points="80,71 100,40 120,71" fill="#0d2a1c"/>
        <rect x="140" y="12" width="16" height="59"/><rect x="160" y="34" width="26" height="37"/>
        <rect x="194" y="6" width="20" height="65"/><rect x="218" y="30" width="18" height="41"/>
        <rect x="244" y="45" width="30" height="26"/><polygon points="288,71 288,38 296,10 304,38 304,71"/>
        <rect x="312" y="28" width="22" height="43"/><rect x="340" y="18" width="18" height="53"/><rect x="362" y="40" width="26" height="31"/>
      </g>
    </svg>
  </div>
</header>

<main>
<section class="sec on" id="t-rapport">
  <div class="c">
    <h2>Nouveau rapport</h2>
    <input id="agent" placeholder="Nom de l'agent" value="N'ké Junior">
    <select id="soc">
      <option value="">Choisis ton entreprise / site</option>
      <option selected>SGCI Total Treichville</option><option>Shell</option><option>Résidence</option><option value="autre">Autre (écrire le nom)</option>
    </select>
    <input id="autre" placeholder="Nom de l'entreprise / du site" hidden>
    <select id="ronde"><option>Ronde RAS</option><option>Ronde avec incident</option><option>Ronde de nuit</option></select>
    <textarea id="faits" rows="4" placeholder="Décris les faits...">Ronde RAS</textarea>
    <div class="vocal">
      <b style="color:var(--vt)">🎤 Rapport vocal (audio + texte)</b>
      <div class="l"><button class="vt" id="bStart" type="button">🎤 Parler</button><button class="rg" id="bStop" type="button" hidden>⏹ Arrêter</button></div>
      <p class="mu" id="vs" aria-live="polite">Appuie sur Parler et décris les faits.</p>
      <audio id="lec" controls style="width:100%" hidden></audio>
      <button class="gr" id="bAud" type="button" hidden>⬇ Télécharger l'audio</button>
    </div>
    <label class="mu" style="display:block;margin-top:10px"><input type="checkbox" id="gps" style="width:auto;margin:0 6px 0 0"> Ajouter ma position GPS</label>
    <button class="vt" id="bGen">Générer le rapport</button>
  </div>
  <div class="c">
    <h2>Rapport</h2>
    <div id="rapport">Aucun rapport pour l'instant.</div>
    <button class="gr" id="bCop">📋 Copier</button>
    <select id="dest"><option value="resp">Envoyer à : Responsable de Sécurité</option><option value="bur">Envoyer à : Bureau Sécurité</option></select>
    <details class="mu" style="margin-top:8px"><summary>📞 Mes numéros WhatsApp</summary>
      <input id="nResp" type="tel" placeholder="N° Responsable de Sécurité (ex : 0707070707)">
      <input id="nBur" type="tel" placeholder="N° Bureau Sécurité (ex : 0505050505)">
      <button class="gr" id="bNum">Enregistrer les numéros</button>
    </details>
    <button class="vt" id="bWA">📲 Envoyer par WhatsApp</button>
    <button class="or" id="bPDF">📄 PDF preuve (Premium)</button>
  </div>
  <div class="c"><h2>Historique</h2><div id="histo" class="mu">Aucun rapport enregistré.</div></div>
</section>

<section class="sec" id="t-outils">
  <div class="c">
    <h2>Horloge universelle</h2>
    <div class="big" id="hAbj">--:--:--</div>
    <div class="mu" id="dAbj" style="text-align:center">Abidjan</div>
    <div id="mondes" style="margin-top:8px"></div>
  </div>
  <div class="c">
    <h2>Chronomètre</h2>
    <div class="big" id="chr">00:00:00.0</div>
    <div class="l"><button class="vt" id="cGo">▶ Démarrer</button><button class="gr" id="cTour">⚑ Tour</button><button class="rg" id="cRaz">↺ Zéro</button></div>
    <div id="tours" class="mu"></div>
  </div>
</section>

<section class="sec" id="t-aide">
  <div class="c"><h2>Assistance : utiliser l'application</h2>
    <div class="log" id="aLog"></div><div class="ch" id="aCh"></div>
    <input id="aIn" placeholder="Pose ta question..."><button class="vt" id="aGo">Envoyer</button></div>
</section>

<section class="sec" id="t-forma">
  <div class="c"><h2>Formation sécurité privée et publique</h2>
    <div class="log" id="fLog"></div><div class="ch" id="fCh"></div>
    <input id="fIn" placeholder="Ex : comment devenir un agent professionnel ?"><button class="vt" id="fGo">Envoyer</button></div>
</section>

<section class="sec" id="t-prem">
  <div class="c">
    <h2>Premium à vie : 1000 F</h2>
    <p class="mu" id="pInfo">Rapports illimités et PDF preuve.</p>
    <div id="boxPrem">
      <button class="or" id="bPay">1. Payer 1000 F par Wave</button>
      <p class="mu">2. Envoie la capture du paiement à <b id="ct"></b>. Tu reçois ton code.</p>
      <input id="code" placeholder="3. Colle ici ton code Premium" autocomplete="off">
      <button class="vt" id="bAct">Activer Premium</button>
    </div>
  </div>
</section>
</main>

<nav>
  <button class="on" data-t="rapport">📝<br>Rapport</button>
  <button data-t="outils">⏱<br>Outils</button>
  <button data-t="aide">💬<br>Aide</button>
  <button data-t="forma">🎓<br>Formation</button>
  <button data-t="prem">⭐<br>Premium</button>
</nav>
<div id="toast" role="status"></div>

<script>
const CONFIG={
  fondateur:"PAPA DERA ELLE",contact:"@papaderaelle",
  waveUrl:"https://pay.wave.com/m/M_ci_BsVtsF_0PH8q/c/ci/?amount=1000",
  limiteGratuit:3,
  codes:["NAVJ-0000"],
  imagePlateau:""
};
const $=id=>document.getElementById(id);
const lire=(k,d)=>{try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}};
const ecrire=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function toast(m){const t=$('toast');t.textContent=m;t.classList.add('on');setTimeout(()=>t.classList.remove('on'),2800)}
$('ct').textContent=CONFIG.contact;
if(CONFIG.imagePlateau)$('plateau').innerHTML=`<img src="${esc(CONFIG.imagePlateau)}" alt="Le Plateau, Abidjan" style="width:100%;border-radius:10px;display:block">`;

document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('on',x===b));
  document.querySelectorAll('.sec').forEach(s=>s.classList.toggle('on',s.id==='t-'+b.dataset.t));
  scrollTo({top:0});
});

const estPrem=()=>CONFIG.codes.includes(String(lire('navj_code','')).toUpperCase());
function majMode(){
  const p=estPrem(),q=lire('navj_quota',{d:'',n:0}),auj=new Date().toDateString();
  $('mode').textContent=p?'Premium':'Gratuit';$('badge').hidden=!p;$('boxPrem').hidden=p;
  $('pInfo').textContent=p?'✅ Premium actif : rapports illimités et PDF preuve.':'Rapports illimités et PDF preuve.';
  $('quota').textContent=p?'Rapports illimités':Math.max(0,CONFIG.limiteGratuit-(q.d===auj?q.n:0))+" rapport(s) gratuit(s) aujourd'hui";
}
$('bPay').onclick=()=>window.open(CONFIG.waveUrl,'_blank','noopener');
$('bAct').onclick=()=>{const c=$('code').value.trim().toUpperCase();
  if(CONFIG.codes.includes(c)){ecrire('navj_code',c);majMode();toast('Premium activé !')}else toast('Code invalide.')};

$('soc').onchange=()=>{$('autre').hidden=$('soc').value!=='autre'};
const societe=()=>$('soc').value==='autre'?$('autre').value.trim():$('soc').value;

const nums=lire('navj_nums',{resp:'',bur:''});$('nResp').value=nums.resp;$('nBur').value=nums.bur;
$('bNum').onclick=()=>{ecrire('navj_nums',{resp:$('nResp').value.trim(),bur:$('nBur').value.trim()});toast('Numéros enregistrés')};
function intl(n){n=String(n).replace(/\D/g,'');if(n.length===10&&n[0]==='0')n='225'+n;return n.length>=11?n:''}

let rec,flux,morc=[],blob=null,reco,tf='';
$('bStart').onclick=async()=>{
  if(!navigator.mediaDevices||!window.MediaRecorder){toast("Micro non disponible. Écris les faits.");return}
  try{flux=await navigator.mediaDevices.getUserMedia({audio:true})}catch(e){$('vs').textContent="Micro refusé. Autorise le micro (lien https).";return}
  morc=[];rec=new MediaRecorder(flux);rec.ondataavailable=e=>morc.push(e.data);
  rec.onstop=()=>{blob=new Blob(morc,{type:rec.mimeType||'audio/webm'});$('lec').src=URL.createObjectURL(blob);$('lec').hidden=false;$('bAud').hidden=false;flux.getTracks().forEach(t=>t.stop());$('vs').textContent="✅ Audio enregistré. Vérifie le texte.";};
  rec.start();
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  tf=($('faits').value&&$('faits').value!=='Ronde RAS')?$('faits').value+' ':'';
  if(SR){reco=new SR();reco.lang='fr-FR';reco.interimResults=true;reco.continuous=true;
    reco.onresult=ev=>{let p='';for(let i=ev.resultIndex;i<ev.results.length;i++){const t=ev.results[i][0].transcript;if(ev.results[i].isFinal)tf+=t+' ';else p+=t}$('faits').value=tf+p};
    reco.onerror=()=>{};try{reco.start()}catch(e){}$('vs').textContent="🎧 J'écoute... parle maintenant.";
  }else $('vs').textContent="🎧 Audio en cours (pas de texte automatique ici).";
  $('bStart').hidden=true;$('bStop').hidden=false;
};
$('bStop').onclick=()=>{if(rec&&rec.state!=='inactive')rec.stop();if(reco)try{reco.stop()}catch(e){}$('bStart').hidden=false;$('bStop').hidden=true};
$('bAud').onclick=()=>{if(!blob)return;const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=(dernier?dernier.id:'NAVJ-audio')+'.webm';a.click()};

let dernier=null;
const pos=()=>new Promise(r=>{if(!$('gps').checked||!navigator.geolocation)return r('');
  navigator.geolocation.getCurrentPosition(p=>r(p.coords.latitude.toFixed(5)+', '+p.coords.longitude.toFixed(5)),()=>{toast('GPS indisponible');r('')},{timeout:8000})});
$('bGen').onclick=async()=>{
  const ag=$('agent').value.trim(),so=societe(),fa=$('faits').value.trim();
  if(!ag){toast("Entre le nom de l'agent");return}
  if(!so){toast("Choisis ou écris ton entreprise");return}
  if(!fa){toast('Décris les faits');return}
  const pr=estPrem(),auj=new Date().toDateString();
  let q=lire('navj_quota',{d:auj,n:0});if(q.d!==auj)q={d:auj,n:0};
  if(!pr&&q.n>=CONFIG.limiteGratuit){toast('Limite gratuite atteinte. Passe en Premium.');return}
  const g=await pos(),now=new Date(),id='NAVJ-'+now.getTime().toString(36).toUpperCase().slice(-6);
  const txt=`🏢 ${so.toUpperCase()}\nRAPPORT DE RONDE - NAVJ AI SÉCURITÉ\n\nID : ${id}\nAgent : ${ag}\nType : ${$('ronde').value}\nDate : ${now.toLocaleString('fr-FR')}${g?'\nPosition : '+g:''}${blob?'\nAudio : joint ('+id+'.webm)':''}\n\nFAITS :\n${fa}\n\nFondé par ${CONFIG.fondateur} ${CONFIG.contact}`;
  dernier={id,txt,date:now.toISOString()};$('rapport').textContent=txt;
  if(!pr){q.n++;ecrire('navj_quota',q)}
  const h=lire('navj_histo',[]);h.unshift(dernier);ecrire('navj_histo',h.slice(0,30));
  majMode();histo();toast('Rapport généré et enregistré');
};
$('bCop').onclick=async()=>{if(!dernier){toast("Génère d'abord un rapport");return}try{await navigator.clipboard.writeText(dernier.txt);toast('Copié !')}catch(e){toast('Copie impossible ici')}};
$('bWA').onclick=()=>{
  if(!dernier){toast("Génère d'abord un rapport");return}
  const n=intl(lire('navj_nums',{resp:'',bur:''})[$('dest').value]);
  if(!n){toast("Enregistre d'abord ce numéro dans « Mes numéros WhatsApp »");return}
  window.open('https://wa.me/'+n+'?text='+encodeURIComponent(dernier.txt),'_blank','noopener');
};
$('bPDF').onclick=()=>{
  if(!estPrem()){toast('Le PDF preuve est réservé au Premium');return}
  if(!dernier){toast("Génère d'abord un rapport");return}
  const w=window.open('','_blank');if(!w){toast('Autorise les pop-up');return}
  w.document.write(`<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><title>${dernier.id}</title><style>body{font-family:sans-serif;padding:32px;max-width:700px;margin:auto}h1{font-size:20px;border-bottom:3px solid #F77F00;padding-bottom:8px}pre{white-space:pre-wrap;font:15px/1.5 sans-serif}footer{margin-top:30px;font-size:12px;color:#555}</style></head><body><h1>NAVJ AI SÉCURITÉ</h1><pre>${esc(dernier.txt)}</pre><footer>Généré le ${new Date().toLocaleString('fr-FR')} - ID ${dernier.id}</footer><script>onload=()=>print()<\/script></body></html>`);
  w.document.close();
};
function histo(){
  const h=lire('navj_histo',[]),b=$('histo');if(!h.length){b.textContent='Aucun rapport enregistré.';return}
  b.innerHTML='';h.forEach(r=>{const l=document.createElement('div');l.className='h';
    l.innerHTML=`<span>${esc(r.id)}<br><span class="mu">${new Date(r.date).toLocaleString('fr-FR')}</span></span>`;
    const x=document.createElement('button');x.className='gr';x.textContent='Ouvrir';
    x.onclick=()=>{dernier=r;$('rapport').textContent=r.txt;scrollTo({top:0,behavior:'smooth'})};l.appendChild(x);b.appendChild(l)});
}

const VILLES=[["Paris","Europe/Paris"],["Londres","Europe/London"],["New York","America/New_York"],["Dubaï","Asia/Dubai"],["Pékin","Asia/Shanghai"],["Tokyo","Asia/Tokyo"]];
const hm=(z,s)=>new Date().toLocaleTimeString('fr-FR',{timeZone:z,hour:'2-digit',minute:'2-digit',...(s?{second:'2-digit'}:{})});
function tic(){
  $('hAbj').textContent=hm('Africa/Abidjan',1);
  $('dAbj').textContent='Abidjan · '+new Date().toLocaleDateString('fr-FR',{timeZone:'Africa/Abidjan',weekday:'long',day:'numeric',month:'long',year:'numeric'});
  $('mondes').innerHTML=VILLES.map(v=>`<div class="cl"><span>${v[0]}</span><b>${hm(v[1],1)}</b></div>`).join('');
}
setInterval(tic,1000);tic();

let t0=0,acc=0,run=false,iv,nT=0;
const fmt=ms=>{const s=ms/1000,h=Math.floor(s/3600),m=Math.floor(s%3600/60),x=(s%60).toFixed(1).padStart(4,'0');return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+x};
const cur=()=>acc+(run?performance.now()-t0:0);
$('cGo').onclick=()=>{if(run){acc=cur();run=false;clearInterval(iv);$('cGo').textContent='▶ Reprendre'}else{t0=performance.now();run=true;iv=setInterval(()=>$('chr').textContent=fmt(cur()),100);$('cGo').textContent='⏸ Pause'}};
$('cTour').onclick=()=>{if(!cur())return;nT++;$('tours').insertAdjacentHTML('afterbegin',`<div class="cl"><span>Tour ${nT}</span><b>${fmt(cur())}</b></div>`)};
