const VW=['passation','incident','ronde','archives','doc'];
function show(v){VW.forEach(x=>$('v-'+x).hidden=x!==v);if(v==='archives')arch();scrollTo({top:0})}
[['passation','🔄 Passation'],['incident','⚠️ Incident'],['ronde','✅ Ronde'],['archives','🗂 Archives']].forEach(c=>{const b=document.createElement('button');b.textContent=c[1];b.onclick=()=>{cour=null;show(c[0])};$('svT').appendChild(b)});
$('p_dt').value=now();$('i_dt').value=now();$('p_site').value=societe();$('ckSite').value=societe();
$('i_cls').onchange=()=>{$('iUrg').hidden=!['Incident','Urgent'].includes($('i_cls').value)};
const col=(p,F)=>Object.fromEntries(F.map(f=>[f[0],$(p+'_'+f[0]).value.trim()]));
const fmtD=v=>v?new Date(v).toLocaleString('fr-FR'):'';
function txt(r){const L=TY[r.type]?TY[r.type].F:r.F;return `🏢 ${(r.soc||'').toUpperCase()}\n${r.titre} - NAVJ AI SÉCURITÉ\n\nN° : ${r.id}\nStatut : ${LS[r.statut]}\n\n`+L.map(f=>`${f[1]} : ${(f[2]==='dt'?fmtD(r.d[f[0]]):r.d[f[0]])||'Non renseigné'}`).join('\n')+(r.recep?`\n\nRÉCEPTION : ${r.recep}`:'')+"\n\nDocument généré par l'application, sans signature électronique certifiée."}
function sauver(type,statut){
  const T=TY[type],p=type==='passation'?'p':'i',d=col(p,T.F);
  if(statut!=='brouillon'){const m=T.req.filter(k=>!d[k]);if(m.length){toast('Champ obligatoire : '+T.F.find(f=>f[0]===m[0])[1]);return}}
  const a=get();let r=cour&&cour.type===type?a.find(x=>x.id===cour.id):null;
  if(r){r.d=d;r.statut=statut}else{r={id:T.p+'-'+Date.now().toString(36).toUpperCase().slice(-6),type,titre:T.t,statut,date:new Date().toISOString(),soc:societe(),d};a.unshift(r)}
  put(a);cour=null;toast('Enregistré sur cet appareil : '+LS[statut]);ouvrir(r.id);
}
$('pBr').onclick=()=>sauver('passation','brouillon');
$('pEn').onclick=()=>sauver('passation','en_attente');
$('iEn').onclick=()=>sauver('incident','enregistre');
function ckR(){$('ckRows').innerHTML=CKL.map((c,i)=>`<div class="ck"><b>${esc(c)}</b><select id="ck${i}"><option>Non vérifié</option><option>Conforme</option><option>Non conforme</option></select><input id="ko${i}" placeholder="Observation"></div>`).join('')}
ckR();
$('ckAdd').onclick=()=>{const x=$('ckNew').value.trim();if(!x)return;const sv=CKL.map((_,i)=>[$('ck'+i).value,$('ko'+i).value]);CKL.push(x);ecrire('navj_ckl',CKL);ckR();sv.forEach((v,i)=>{$('ck'+i).value=v[0];$('ko'+i).value=v[1]});$('ckNew').value=''};
$('ckSave').onclick=()=>{
  if(!$('ckSite').value.trim()){toast('Indique le site ou le poste');return}
  const F=[['site','Site ou poste','txt'],['dt','Date et heure','dt'],...CKL.map((c,i)=>['c'+i,c,'txt'])];
  const d={site:$('ckSite').value.trim(),dt:now()};
  CKL.forEach((c,i)=>{const o=$('ko'+i).value.trim();d['c'+i]=$('ck'+i).value+(o?' - '+o:'')});
  const r={id:'RON-'+Date.now().toString(36).toUpperCase().slice(-6),type:'ronde',titre:'CHECKLIST DE RONDE',statut:'enregistre',date:new Date().toISOString(),soc:societe(),d,F};
  const a=get();a.unshift(r);put(a);toast('Checklist enregistrée sur cet appareil');ouvrir(r.id);
};
function arch(){
  const t=$('arT').value,q=$('arQ').value.toLowerCase();
  const a=get().filter(r=>(t==='tous'||r.type===t)&&(!q||txt(r).toLowerCase().includes(q)));
  $('arL').innerHTML=a.length?a.map(r=>`<div class="h"><span>${esc(r.id)} <span class="st ${r.statut}">${LS[r.statut]}</span><br><span class="mu">${new Date(r.date).toLocaleString('fr-FR')} · ${esc(r.titre)}</span></span><span><button class="gr" data-o="${r.id}">Ouvrir</button> <button class="rg" data-x="${r.id}">✕</button></span></div>`).join(''):'<p class="mu">Aucun document.</p>';
}
$('arT').onchange=arch;$('arQ').oninput=arch;
$('arL').onclick=e=>{const o=e.target.dataset.o,x=e.target.dataset.x;if(o)ouvrir(o);if(x&&confirm('Supprimer ce document définitivement ?')){put(get().filter(r=>r.id!==x));arch();toast('Document supprimé')}};
$('bkS').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({svc:get(),histo:lire('navj_histo',[])})],{type:'application/json'}));a.download='navj-sauvegarde.json';a.click();toast('Fichier de sauvegarde créé : garde-le en lieu sûr')};
$('bkR').onchange=e=>{const f=e.target.files[0];if(!f||!confirm('Remplacer les données actuelles par la sauvegarde ?'))return;const rd=new FileReader();rd.onload=()=>{try{const o=JSON.parse(rd.result);if(!Array.isArray(o.svc))throw 0;put(o.svc);if(Array.isArray(o.histo))ecrire('navj_histo',o.histo);arch();toast('Sauvegarde restaurée')}catch(x){toast('Fichier invalide')}};rd.readAsText(f)};
function ouvrir(id){
  const r=get().find(x=>x.id===id);if(!r)return;
  const edit=(r.type==='passation'||r.type==='incident')&&r.statut!=='validee';
  $('v-doc').dataset.id=id;
  $('v-doc').innerHTML=`<h2>${esc(r.id)} <span class="st ${r.statut}">${LS[r.statut]}</span></h2><div style="background:#fff;color:#111;padding:12px;border-radius:10px;white-space:pre-wrap;font-size:14px">${esc(txt(r))}</div>`
  +(r.type==='passation'&&r.statut==='en_attente'?`<div class="avt">Réception par le destinataire, sur cet appareil</div><input id="rNom" placeholder="Nom complet du destinataire"><textarea id="rObs" rows="2" placeholder="Observations ou réserves"></textarea><label class="lab"><input type="checkbox" id="rOk" style="width:auto"> Je confirme avoir reçu le poste et les équipements décrits.</label><button class="vt" data-a="val">✅ Confirmer la réception</button><button class="rg" data-a="res">⚠ Signaler une réserve</button>`:'')
  +`<input id="wNum" type="tel" placeholder="Numéro WhatsApp du destinataire" value="${esc(lire('navj_nums',{}).resp||'')}"><button class="vt" data-a="wa">📲 Préparer WhatsApp</button>`+(edit?'<button class="gr" data-a="mod">✏️ Modifier</button>':'')+'<button class="gr" data-a="exp">⬇ Exporter (.txt)</button><button class="gr" data-a="imp">🖨 Imprimer ou PDF</button><button class="gr" data-a="ret">← Retour aux archives</button>';
  show('doc');
}
function maj(r,s,nom,obs){const A=get(),x=A.find(y=>y.id===r.id);x.statut=s;x.recep=`${nom} le ${new Date().toLocaleString('fr-FR')}${obs?' : '+obs:' (sans réserve)'}`;put(A);ouvrir(x.id)}
$('v-doc').onclick=e=>{
  const a=e.target.dataset.a;if(!a)return;
  const r=get().find(x=>x.id===$('v-doc').dataset.id);if(!r)return;
  if(a==='ret')return show('archives');
  if(a==='mod'){cour=r;const p=r.type==='passation'?'p':'i';TY[r.type].F.forEach(f=>$(p+'_'+f[0]).value=r.d[f[0]]||'');show(r.type);return}
  if(a==='exp'){const l=document.createElement('a');l.href=URL.createObjectURL(new Blob([txt(r)],{type:'text/plain;charset=utf-8'}));l.download=r.id+'.txt';l.click();toast('Fichier texte créé');return}
  if(a==='imp'){const w=window.open('','_blank');if(!w){toast('Autorise les pop-up');return}w.document.write(`<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><title>${esc(r.id)}</title><style>body{font-family:sans-serif;padding:32px;max-width:700px;margin:auto}pre{white-space:pre-wrap;font:15px/1.5 sans-serif}</style></head><body><pre>${esc(txt(r))}</pre><script>onload=()=>print()<\/script></body></html>`);w.document.close();return}
  if(a==='wa'){const n=intl($('wNum').value);if(!n){toast('Numéro invalide');return}if(!confirm('Ouvrir WhatsApp vers +'+n+' avec ce document ? Vérifie bien le destinataire.'))return;window.open('https://wa.me/'+n+'?text='+encodeURIComponent(txt(r)),'_blank','noopener');toast("WhatsApp ouvert : c'est à toi de confirmer l'envoi");return}
  if(a==='val'||a==='res'){
    const nom=$('rNom').value.trim(),obs=$('rObs').value.trim();
    if(nom.toLowerCase()!==String(r.d.a).toLowerCase()){toast('Le nom doit être celui du destinataire : '+r.d.a);return}
    if(a==='val'){if(!$('rOk').checked){toast('Coche la confirmation de réception');return}maj(r,'validee',nom,obs);toast('Réception confirmée par le destinataire')}
    else{if(!obs){toast('Écris la réserve dans les observations');return}maj(r,'reserves',nom,obs);toast('Réserve enregistrée')}
  }
};
})();
</script>
</body>
</html>
